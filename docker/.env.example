# =============================================================================
# Docker Environment Variables
# =============================================================================
# These are merged into the main .env.example at project root.
# Copy the main .env.example to .env for full configuration.

# =============================================================================
# Docker Compose Settings
# =============================================================================

# Project name for docker compose
COMPOSE_PROJECT_NAME=dap

# Docker image tag
DAP_IMAGE_TAG=latest

# =============================================================================
# Port Configuration
# =============================================================================

# Grafana Dashboard Port (exposed on host)
GRAFANA_PORT=3001

# Prometheus Metrics Server Port (exposed on host)
PROMETHEUS_PORT=9090

# Alertmanager Alert Routing Port (exposed on host)
ALERTMANAGER_PORT=9093

# =============================================================================
# Grafana Configuration
# =============================================================================

# Grafana Admin Password (change in production!)
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# Alerting Configuration (Alertmanager)
# =============================================================================

# SMTP Settings for Alertmanager email notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-smtp-password
ALERT_EMAIL_TO=admin@example.com,oncall@example.com

# Slack webhook for Alertmanager Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK