# DAP Relay Server Configuration
# Copy to .env and customize

# ============ Network ============
PORT=3000
HOST=0.0.0.0

# TLS (HTTPS/WSS) - optional but recommended for production
ENABLE_TLS=true
TLS_PORT=3443
TLS_CERT_PATH=./certs/cert.pem
TLS_KEY_PATH=./certs/key.pem

# ============ Security ============
# API Keys with scopes: read, write, admin
# Format: key1:scope1,key2:scope2,key3 (defaults to 'read' if no scope specified)
# Examples:
#   - Single key with read access: my-read-only-key:read
#   - Single key with write access: my-write-key:write
#   - Single key with admin access: my-admin-key:admin
#   - Multiple keys: key-read:read,key-write:write,key-admin:admin
# Leave empty for open access (development only)
API_KEYS=

# ============ Rate Limiting ============
# Requests per minute per API key/IP
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ============ Heartbeat ============
# Agent heartbeat interval and timeout (milliseconds)
HEARTBEAT_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_MS=60000

# ============ Persistence ============
# Directory for job queue data files
DATA_DIR=./data

# ============ Logging ============
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ============ Prometheus Metrics ============
# Enable /metrics endpoint for Prometheus scraping
ENABLE_METRICS=true
METRICS_PORT=3001

# ============ Security Headers ============
# The following security headers are enabled by default:
# X-Content-Type-Options: nosniff
# X-Frame-Options: DENY
# X-XSS-Protection: 1; mode=block
# Strict-Transport-Security: max-age=31536000; includeSubDomains
# Content-Security-Policy: default-src 'self'
# Referrer-Policy: strict-origin-when-cross-origin
# Permissions-Policy: geolocation=(), microphone=(), camera=()