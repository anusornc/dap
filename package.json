{
  "name": "distributed-agent-protocol",
  "version": "1.0.0",
  "description": "DAP - A protocol for heterogeneous AI agents to coordinate across machines",
  "main": "dist/relay/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/relay/server.js",
    "dev": "tsx watch src/relay/server.ts",
    "relay": "npm run dev",
    "shim:mavis": "tsx src/shims/mavis.ts",
    "shim:claude": "tsx src/shims/claude-code.ts",
    "shim:codex": "tsx src/shims/codex.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "ai-agent",
    "distributed",
    "multi-agent",
    "coordination",
    "protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
